{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentVerify v1 source manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "plugin_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "plugin_version",
    "files"
  ],
  "additionalProperties": false,
  "$defs": {}
}
