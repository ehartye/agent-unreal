{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ignored local Windows remote verification configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source_root", "state_directory", "ssh_target", "remote"],
  "properties": {
    "version": {"const": 1},
    "source_root": {"type": "string", "minLength": 1},
    "state_directory": {"type": "string", "minLength": 1},
    "ssh_target": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,252}$"},
    "remote": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "node", "launcher", "timeouts"],
      "properties": {
        "root": {"type": "string", "pattern": "^[A-Za-z]:[/\\\\]"},
        "node": {"type": "string", "pattern": "^[A-Za-z]:[/\\\\]"},
        "launcher": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "project", "engine", "editorTarget", "gameTarget"],
          "properties": {
            "version": {"const": 1}, "project": {"type": "string"}, "engine": {"type": "string"},
            "editorTarget": {"type": "string"}, "gameTarget": {"type": "string"},
            "configuration": {"enum": ["Debug", "DebugGame", "Development", "Shipping", "Test"]},
            "platform": {"const": "Win64"}, "dotnet": {"type": "string"},
            "packageDirectory": {"type": "string"}, "gameExecutable": {"type": "string"}
          }
        },
        "timeouts": {
          "type": "object", "additionalProperties": false,
          "required": ["transport_seconds", "startup_seconds", "workload_seconds"],
          "properties": {
            "transport_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
            "startup_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
            "workload_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
          }
        }
      }
    }
  }
}
