{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "unreal-run/request/1", "type": "object",
  "required": ["version", "kind", "id", "nonce", "purpose", "operation", "lock", "state", "executable", "arguments", "cwd", "evidence", "node", "timeoutMs", "waitMs", "controllerPid", "controllerCreated"],
  "properties": {
    "version": {"const": 1}, "kind": {"const": "unreal-run/request"}, "id": {"type": "string", "format": "uuid"},
    "nonce": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "purpose": {"enum": ["production", "fixture"]},
    "operation": {"enum": ["build", "editor", "game", "commandlet", "package", "test", "status", "doctor", "clear-stale", "compat"]},
    "lock": {"type": "string"}, "state": {"type": "string", "minLength": 1}, "executable": {"type": "string", "minLength": 1},
    "arguments": {"type": "array", "items": {"type": "string"}}, "cwd": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "node": {"type": "string", "minLength": 1},
    "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 86400000}, "waitMs": {"type": "integer", "minimum": 1, "maximum": 86400000},
    "controllerPid": {"type": "integer", "minimum": 1}, "controllerCreated": {"type": "string", "pattern": "^[0-9]{15,20}$"},
    "fault": {"enum": ["containment", "accounting"]}
  },
  "$comment": "validateRequest additionally binds production to its immutable global lock and refuses fault injection outside isolated fixtures."
}
